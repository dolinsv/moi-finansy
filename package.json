{
  "name": "moi-finansy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:vk": "vk-miniapps-deploy",
    "tunnel": "vk-tunnel --insecure=1 --http-protocol=http --ws-protocol=ws --host=127.0.0.1 --port=5175",
    "tunnel:cf": "npx --yes cloudflared tunnel --url http://127.0.0.1:5175",
    "deploy:pages": "tsc -b && vite build --base=/moi-finansy/ && gh-pages -d dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@vkontakte/vk-bridge": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vkontakte/vk-miniapps-deploy": "^1.0.2",
    "@vkontakte/vk-tunnel": "^0.2.10",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
